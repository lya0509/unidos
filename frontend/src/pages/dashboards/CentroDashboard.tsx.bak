import os

history_path = r'C:\Users\juanl\AppData\Roaming\Code\User\History'

def find_latest(keyword):
    found = []
    for root, dirs, files in os.walk(history_path):
        for file in files:
            if file == 'entries.json':
                continue
            path = os.path.join(root, file)
            try:
                with open(path, 'r', encoding='utf-8', errors='ignore') as f:
                    content = f.read()
                    if keyword in content:
                        found.append((os.path.getmtime(path), path, content))
            except:
                pass
    found.sort(reverse=True, key=lambda x: x[0])
    return found

centro_hist = find_latest('export const CentroDashboard')
if centro_hist:
    print(f'Found CentroDashboard: {len(centro_hist)} versions. Latest from {centro_hist[0][1]}')
    with open('C:/VENEZUELA/frontend/src/pages/dashboards/CentroDashboard.tsx', 'w', encoding='utf-8') as f:
        f.write(centro_hist[0][2])
else:
    print('CentroDashboard not found in history')

